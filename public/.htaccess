# public/.htaccess
#
# Apache URL rewriting - routes all non-file requests through index.php.
# Enables clean URLs like /products/42 instead of ?page=products&id=42.
#
# Requires: Apache mod_rewrite enabled, AllowOverride All in VirtualHost config.

Options -Indexes
Options -MultiViews

RewriteEngine On


# Allow direct access to real files (CSS, JS, images) and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d


# Route everything else through the front controller

RewriteRule ^(.*)$ index.php [L]

# ─── Security Headers ─────────────────────────────────────────────────────────
# TODO: Uncomment and configure these headers before deploying to the cloud server.
#
# Header always set X-Content-Type-Options "nosniff"
# Header always set X-Frame-Options "SAMEORIGIN"
# Header always set Referrer-Policy "strict-origin-when-cross-origin"
#
# Content Security Policy - tighten this once your CDN URLs are finalised:
# Header always set Content-Security-Policy "default-src 'self'; \
#   script-src 'self' https://cdn.jsdelivr.net; \
#   style-src  'self' https://cdn.jsdelivr.net; \
#   font-src   'self' https://cdn.jsdelivr.net; \
#   img-src    'self' data:"



